+    function updateStreamMetrics(msg) {
+      const metricsEl = document.getElementById("streamMetrics");
+      if (!metricsEl) return;
+
+      const heartbeatMs = Number(msg && msg.heartbeat_ms);
+      if (Number.isFinite(heartbeatMs)) {
+        if (lastHeartbeatMs !== null && heartbeatMs + 2000 < lastHeartbeatMs) {
+          streamLagMinOffsetMs = null;
+        }
+        lastHeartbeatMs = heartbeatMs;
+
+        const offsetMs = Date.now() - heartbeatMs;
+        if (streamLagMinOffsetMs === null || offsetMs < streamLagMinOffsetMs) {
+          streamLagMinOffsetMs = offsetMs;
+        }
+        streamLagMs = Math.max(0, offsetMs - streamLagMinOffsetMs);
+      }
+
+      if (msg.ws_skip_backlog_total !== undefined) {
+        const v = Number(msg.ws_skip_backlog_total);
+        if (Number.isFinite(v) && v >= 0) streamBacklogDrops = Math.round(v);
+      }
+      if (msg.ws_skip_full_total !== undefined) {
+        const v = Number(msg.ws_skip_full_total);
+        if (Number.isFinite(v) && v >= 0) streamFullDrops = Math.round(v);
+      }
+      if (msg.ws_skip_nosend_total !== undefined) {
+        const v = Number(msg.ws_skip_nosend_total);
+        if (Number.isFinite(v) && v >= 0) streamNoSendDrops = Math.round(v);
+      }
+
+      metricsEl.textContent =
+        `Lag: ${Math.round(streamLagMs)} ms | Backlog drops: ${streamBacklogDrops} | Full: ${streamFullDrops} | NoSend: ${streamNoSendDrops}`;
+    }
