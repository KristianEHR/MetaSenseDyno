+bool Adafruit_NAU7802::calibrate(NAU7802_Calibration mode, uint16_t timeout_ms) {
+  if (!_initialized) {
+    return false;
+  }
+
+  bool ok = false;
+  uint8_t ctrl2 = readRegister(NAU7802_CTRL2, &ok);
+  if (!ok) {
+    return false;
