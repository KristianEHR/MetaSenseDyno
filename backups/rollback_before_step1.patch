+void loadCellSamplerTask(void* /*pvParameters*/)
+{
+    for (;;) {
+        const uint32_t startedUs = micros();
+        if (!loadCellExclusiveSampling) {
+            if (loadCellNauReady) {
+                float rawSamples[8];
+                uint8_t rawCount = 0;
