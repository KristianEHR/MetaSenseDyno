+void sortFloatArray(float* values, uint8_t count)
+{
+    for (uint8_t i = 1; i < count; ++i) {
+        const float key = values[i];
+        int8_t j = static_cast<int8_t>(i) - 1;
+        while (j >= 0 && values[j] > key) {
