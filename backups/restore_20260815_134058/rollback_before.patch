+        fields.joystickGearPosition = static_cast<uint8_t>(METASENSE_LEAF_11A_FORCE_GEAR & 0x0FU);
+    }
+    if (!s_leaf11aStartupProbeEnabled && METASENSE_LEAF_11A_FORCE_CARONOFF <= 0x07U) {
