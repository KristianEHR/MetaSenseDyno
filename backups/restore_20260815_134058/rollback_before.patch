+        const bool shouldLog = (s_leaf11aTxRxLastLogMs == 0U) ||
+                               ((nowMs - s_leaf11aTxRxLastLogMs) >= 1000U) ||
+                               (diffMask != s_leaf11aTxRxLastDiffMask) ||
+                               (eq != s_leaf11aTxRxLastEq);
+        if (shouldLog) {
+            const Leaf11aFrameFields txDecoded = decodeLeaf11aFields(txData, sizeof(txData));
+            const bool txSemanticMatch = (txDecoded.joystickGearPosition == fields.joystickGearPosition) &&
+                                         (txDecoded.carOnOffStatus == fields.carOnOffStatus) &&
+                                         (txDecoded.steeringWheelButton == fields.steeringWheelButton) &&
+                                         (txDecoded.heartbeatVcm == fields.heartbeatVcm) &&
+                                         (txDecoded.unknown11a4 == fields.unknown11a4) &&
+                                         (txDecoded.multiplexor == fields.multiplexor) &&
+                                         (txDecoded.startupData == fields.startupData);
+            Serial.printf("[VCM-11A-TX-SELF] n=%lu sem=%u gear=%u car=%u btn=0x%02X hb=0x%02X u4=0x%02X mux=%u start=0x%02X raw=%02X %02X %02X %02X %02X %02X %02X %02X\n",
+                          static_cast<unsigned long>(canStats.tx11aFrames + 1U),
+                          txSemanticMatch ? 1U : 0U,
+                          static_cast<unsigned>(txDecoded.joystickGearPosition),
+                          static_cast<unsigned>(txDecoded.carOnOffStatus),
+                          static_cast<unsigned>(txDecoded.steeringWheelButton),
+                          static_cast<unsigned>(txDecoded.heartbeatVcm),
+                          static_cast<unsigned>(txDecoded.unknown11a4),
+                          static_cast<unsigned>(txDecoded.multiplexor),
+                          static_cast<unsigned>(txDecoded.startupData),
+                          static_cast<unsigned>(txData[0]),
+                          static_cast<unsigned>(txData[1]),
+                          static_cast<unsigned>(txData[2]),
+                          static_cast<unsigned>(txData[3]),
+                          static_cast<unsigned>(txData[4]),
+                          static_cast<unsigned>(txData[5]),
+                          static_cast<unsigned>(txData[6]),
+                          static_cast<unsigned>(txData[7]));
+            Serial.printf("[VCM-11A-TXRX] eq=%d diff=0x%02X tx_n=%lu rx_n=%lu tx=%02X %02X %02X %02X %02X %02X %02X %02X rx=%02X %02X %02X %02X %02X %02X %02X %02X\n",
+                          static_cast<int>(eq),
+                          static_cast<unsigned>(diffMask),
+                          static_cast<unsigned long>(canStats.tx11aFrames + 1U),
+                          static_cast<unsigned long>(canStats.rx11aFrames),
+                          static_cast<unsigned>(txData[0]),
+                          static_cast<unsigned>(txData[1]),
+                          static_cast<unsigned>(txData[2]),
+                          static_cast<unsigned>(txData[3]),
+                          static_cast<unsigned>(txData[4]),
+                          static_cast<unsigned>(txData[5]),
+                          static_cast<unsigned>(txData[6]),
+                          static_cast<unsigned>(txData[7]),
+                          static_cast<unsigned>(templateData[0]),
+                          static_cast<unsigned>(templateData[1]),
+                          static_cast<unsigned>(templateData[2]),
+                          static_cast<unsigned>(templateData[3]),
+                          static_cast<unsigned>(templateData[4]),
+                          static_cast<unsigned>(templateData[5]),
+                          static_cast<unsigned>(templateData[6]),
+                          static_cast<unsigned>(templateData[7]));
+            s_leaf11aTxRxLastLogMs = nowMs;
+            s_leaf11aTxRxLastDiffMask = diffMask;
+            s_leaf11aTxRxLastEq = eq;
+        }
+        lastLeaf11aTxMs = nowMs;
+        if (muxOverride <= 3U) {
+            s_leaf11aMuxTxSeq = static_cast<uint8_t>((muxSel + 1U) & 0x03U);
+        } else {
+            s_leaf11aMuxTxSeq = static_cast<uint8_t>((s_leaf11aMuxTxSeq + 1U) & 0x03U);
+        }
+    }
+    return sent;
+}
