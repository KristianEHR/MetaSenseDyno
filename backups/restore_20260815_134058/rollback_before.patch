+String buildStartup11aMuxGroupedCsv(File& file)
+{
+    String out;
+    out.reserve(32768);
+    out += "mux_group,mux_seq,dt_ms,id_hex,id_dec,len,ext,gear,car_onoff,eco,btn,hb,mux,u4,startup,b0,b1,b2,b3,b4,b5,b6,b7\n";
+
+    std::array<String, 4> groupedRows;
+    std::array<uint32_t, 4> groupedCounts = {0U, 0U, 0U, 0U};
+    String otherRows;
+
+    while (file.available()) {
+        String line = file.readStringUntil('\n');
+        line.trim();
+        if (line.isEmpty()) {
+            continue;
+        }
+        if (line.startsWith("meta,") || line.startsWith("dt_ms,")) {
+            continue;
+        }
+
+        String muxField;
+        if (!extractCsvField(line, 10, muxField)) {
+            continue;
+        }
+        const int mux = muxField.toInt();
+
+        if (mux >= 0 && mux <= 3) {
+            groupedRows[static_cast<size_t>(mux)] += String(mux);
+            groupedRows[static_cast<size_t>(mux)] += ",";
+            groupedRows[static_cast<size_t>(mux)] += String(groupedCounts[static_cast<size_t>(mux)]++);
+            groupedRows[static_cast<size_t>(mux)] += ",";
+            groupedRows[static_cast<size_t>(mux)] += line;
+            groupedRows[static_cast<size_t>(mux)] += "\n";
+        } else {
+            otherRows += String(mux);
+            otherRows += ",-1,";
+            otherRows += line;
+            otherRows += "\n";
+        }
+    }
+
+    for (size_t m = 0; m < groupedRows.size(); ++m) {
+        out += groupedRows[m];
+    }
+    out += otherRows;
+    return out;
+}
