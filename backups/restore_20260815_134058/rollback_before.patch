+bool extractCsvField(const String& line, int targetIndex, String& outField)
+{
+    if (targetIndex < 0) {
+        return false;
+    }
+
+    int fieldIndex = 0;
+    int start = 0;
+    const int n = static_cast<int>(line.length());
+    for (int i = 0; i <= n; ++i) {
+        const bool atEnd = (i == n);
+        if (atEnd || line[i] == ',') {
+            if (fieldIndex == targetIndex) {
+                outField = line.substring(start, i);
+                outField.trim();
+                return true;
+            }
+            ++fieldIndex;
+            start = i + 1;
+        }
+    }
+    return false;
+}
