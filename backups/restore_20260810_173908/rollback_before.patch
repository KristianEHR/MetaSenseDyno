+float computeKeepAliveTrapezoidNm(uint32_t nowMs, bool enabled)
+{
+    const float minNm = METASENSE_LEAF_1D4_KEEPALIVE_TRAPEZOID_MIN_NM;
+    const float maxNm = METASENSE_LEAF_1D4_KEEPALIVE_TRAPEZOID_MAX_NM;
+    const float stepNm = METASENSE_LEAF_1D4_KEEPALIVE_TRAPEZOID_STEP_NM;
+    const float startNegNm = METASENSE_LEAF_1D4_KEEPALIVE_TRAPEZOID_START_NEG_NM;
+    const float zeroPosNm = METASENSE_LEAF_1D4_KEEPALIVE_ZERO_POS_NM;
+
+    if (!enabled) {
+        s_keepAliveTrapNm = minNm;
+        s_keepAliveTrapDir = 1;
+        s_keepAliveTrapLastStepMs = 0U;
+        s_keepAliveTrapKickIssued = false;
+        s_keepAliveLastZeroCrossMs = 0U;
+        s_keepAliveZeroPulseStartMs = 0U;
+        s_keepAliveZeroPulseActive = false;
+        s_keepAliveZeroPulsePhase = 0U;
+        return 0.0f;
+    }
+
+    if (!s_keepAliveTrapKickIssued) {
+        s_keepAliveTrapKickIssued = true;
+        s_keepAliveTrapLastStepMs = nowMs;
+        s_keepAliveTrapNm = minNm;
+        s_keepAliveTrapDir = 1;
+        s_keepAliveLastZeroCrossMs = nowMs;
+        s_keepAliveZeroPulseStartMs = nowMs;
+        s_keepAliveZeroPulseActive = true;
+        s_keepAliveZeroPulsePhase = 1U;
+        return zeroPosNm;
+    }
+
+    if (!s_keepAliveZeroPulseActive) {
+        const bool refreshDue = (s_keepAliveLastZeroCrossMs == 0U) ||
+                                (elapsedMsSafe(nowMs, s_keepAliveLastZeroCrossMs) >=
+                                 METASENSE_LEAF_1D4_KEEPALIVE_ZERO_REFRESH_MS);
+        if (refreshDue) {
+            s_keepAliveLastZeroCrossMs = nowMs;
+            s_keepAliveZeroPulseStartMs = nowMs;
+            s_keepAliveZeroPulseActive = true;
+            s_keepAliveZeroPulsePhase = 1U;
+        }
+    }
+
+    if (s_keepAliveZeroPulseActive) {
+        const uint32_t phaseElapsedMs = elapsedMsSafe(nowMs, s_keepAliveZeroPulseStartMs);
+        if (s_keepAliveZeroPulsePhase == 1U) {
+            if (phaseElapsedMs < METASENSE_LEAF_1D4_KEEPALIVE_ZERO_PRE_POS_MS) {
+                return zeroPosNm;
+            }
+            s_keepAliveZeroPulsePhase = 2U;
+            s_keepAliveZeroPulseStartMs = nowMs;
+            return startNegNm;
+        }
+
+        if (s_keepAliveZeroPulsePhase == 2U) {
+            if (phaseElapsedMs < METASENSE_LEAF_1D4_KEEPALIVE_ZERO_PULSE_MS) {
+                return startNegNm;
+            }
+            s_keepAliveZeroPulsePhase = 3U;
+            s_keepAliveZeroPulseStartMs = nowMs;
+            return zeroPosNm;
+        }
+
+        if (s_keepAliveZeroPulsePhase == 3U) {
+            if (phaseElapsedMs < METASENSE_LEAF_1D4_KEEPALIVE_ZERO_POST_POS_MS) {
+                return zeroPosNm;
+            }
+            s_keepAliveZeroPulseActive = false;
+            s_keepAliveZeroPulsePhase = 0U;
+        } else {
+            s_keepAliveZeroPulseActive = false;
+            s_keepAliveZeroPulsePhase = 0U;
+        }
+
+        if (s_keepAliveZeroPulseActive) {
+            return startNegNm;
+        }
+    }
+
+    if (s_keepAliveTrapLastStepMs == 0U) {
+        s_keepAliveTrapLastStepMs = nowMs;
+        s_keepAliveTrapNm = minNm;
+        s_keepAliveTrapDir = 1;
+        return s_keepAliveTrapNm;
+    }
+
+    if ((nowMs - s_keepAliveTrapLastStepMs) >= METASENSE_LEAF_1D4_KEEPALIVE_TRAPEZOID_STEP_MS) {
+        s_keepAliveTrapLastStepMs = nowMs;
+        s_keepAliveTrapNm += static_cast<float>(s_keepAliveTrapDir) * stepNm;
+
+        if (s_keepAliveTrapNm >= maxNm) {
+            s_keepAliveTrapNm = maxNm;
+            s_keepAliveTrapDir = -1;
+        } else if (s_keepAliveTrapNm <= minNm) {
+            s_keepAliveTrapNm = minNm;
+            s_keepAliveTrapDir = 1;
+        }
+    }
+
+    return constrain(s_keepAliveTrapNm, minNm, maxNm);
+}
