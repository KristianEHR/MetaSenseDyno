; MetaSense-DYNO PlatformIO Configuration
;
; Active Compile-time Configuration:
;
; - ENABLE_CAN_METRICS (default: 0)
;   Enable CAN Rx/Tx traffic metrics (frame counts, timestamps, diagnostics)
;   When 0 (disabled): Minimal CPU/memory, production build
;   When 1 (enabled): Full metrics for testing/debugging
;   Telemetry cadence auto-adapts: 16ms (metrics off) or 33ms (metrics on)
;
; - CAN_METRICS_ENABLED
;   Enable detailed CAN frame data in WebSocket (0x1DA/0x55A/0x11A/0x1D4)
;   esp32s3-ota: enabled (1) for OTA testing
;   esp32s3-USB: disabled (0) for USB build
;
; - METASENSE_WS_FAST_PERIOD_MS
;   Telemetry update interval (ms). Automatically set based on ENABLE_CAN_METRICS:
;   Metrics disabled: 16ms (~62.5 Hz)
;   Metrics enabled: 33ms (~30 Hz)
;
; - CAN/Hardware Configuration
;   Pin assignments, torque calibration, frame templates, relay/heartbeat settings
;


[env:esp32s3-ota]
platform      = espressif32
board         = esp32-s3-devkitc-1
framework     = arduino
build_src_filter =
    +<*>
    -<egt_diag.cpp>
board_build.partitions = partitions/esp32s3_8mb_ota_littlefs.csv
board_build.filesystem = littlefs
build_type    = release
build_flags =
    -D ARDUINO_USB_MODE=1
    -D ARDUINO_USB_CDC_ON_BOOT=1
    -D CAN_METRICS_ENABLED=1
    -D ENABLE_CAN_METRICS=0
    -D METASENSE_CAN_ID_SCAN=0
    -I include
lib_ldf_mode    = deep+
lib_compat_mode = strict
lib_deps =
    adafruit/Adafruit NeoPixel @ 1.15.5
    adafruit/Adafruit MCP9600 Library @ 2.0.4
    me-no-dev/ESPAsyncWebServer @ 3.6.0
    me-no-dev/AsyncTCP @ 3.3.2 
;   adafruit/Adafruit BME0 Library @ ^3.0.0
    adafruit/Adafruit BME680 Library @ ^2.0.4
    bblanchon/ArduinoJson @ ^7.0.0
lib_ignore =
upload_protocol = espota
upload_port = 192.168.0.211
upload_flags =
    --auth=metasense
; Network-based serial monitoring via telnet on OTA device at 192.168.0.211
monitor_speed = 115200
monitor_port = socket://192.168.0.211:23
monitor_dtr = 0
monitor_rts = 0

[env:esp32s3-USB]

platform      = espressif32
board         = esp32-s3-devkitc-1
